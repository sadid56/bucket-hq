generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  ADMIN
  MEMBER
}

enum OrgRole {
  OWNER
  EDITOR
  VIEWER
}

enum ProviderType {
  AWS_S3
  CLOUDFLARE_R2
  CLOUDINARY
}

enum AccessLevel {
  READ
  WRITE
  READ_WRITE
}

model User {
  id               String            @id // Matches Supabase Auth uid
  email            String            @unique
  name             String
  emailVerified    Boolean           @default(false)
  image            String?
  role             GlobalRole        @default(MEMBER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  banned           Boolean           @default(false)
  banReason        String?
  accounts         Account[]
  sessions         Session[]
  teamAccesses     TeamAccess[]
  auditLogs        AuditLog[]
  pathRestrictions PathRestriction[]
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  teamAccesses       TeamAccess[]
  storageConnections StorageConnection[]
}

model TeamAccess {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole      @default(VIEWER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model StorageConnection {
  id               String            @id @default(cuid())
  organizationId   String
  label            String
  providerType     ProviderType
  encryptedCreds   String            // Encrypted credentials JSON
  iv               String            // Encryption IV
  authTag          String            // Auth tag for AES-GCM
  bucketName       String?
  region           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pathRestrictions PathRestriction[]
  auditLogs        AuditLog[]
}

model PathRestriction {
  id                  String            @id @default(cuid())
  userId              String
  storageConnectionId String
  pathPrefix          String            // Normalized folder path, e.g. "clients/acme/"
  accessLevel         AccessLevel       @default(READ)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageConnection   StorageConnection @relation(fields: [storageConnectionId], references: [id], onDelete: Cascade)

  @@unique([userId, storageConnectionId, pathPrefix])
}

model AuditLog {
  id                  String             @id @default(cuid())
  userId              String
  action              String             // e.g., "SIGN_UPLOAD", "DELETE_OBJECT", "REVOKE_CONNECTION"
  ipAddress           String?
  objectPath          String?
  details             String?            // Extra metadata
  storageConnectionId String?
  createdAt           DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageConnection   StorageConnection? @relation(fields: [storageConnectionId], references: [id], onDelete: SetNull)
}

